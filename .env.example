# Dashboard (portal.igc-growth.com) — production environment template.
# Copy to `.env.local` for development and fill values there.
# Do not commit real secrets; `.env.local` is gitignored.

# NextAuth — canonical dashboard URL and signing secret
# Production:
NEXTAUTH_URL=https://portal.igc-growth.com
# Development (.env.local): NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                  # generate: openssl rand -base64 32
AUTH_SECRET=                      # alias some Auth.js versions expect; same value as NEXTAUTH_SECRET

# CometChat (messaging)
COMETCHAT_APP_ID=
COMETCHAT_REGION=
COMETCHAT_AUTH_KEY=

# Database (when added)
# DATABASE_URL=
